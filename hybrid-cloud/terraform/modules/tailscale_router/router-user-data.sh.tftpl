#!/bin/bash
set -eux

cat > /etc/sysctl.d/99-ticketrail-router.conf <<'EOF'
net.ipv4.ip_forward = 1
EOF

sysctl --system

curl -fsSL https://tailscale.com/install.sh | sh

systemctl enable --now tailscaled

cat > /usr/local/sbin/ticketrail-tailscale-configure <<'EOF'
#!/bin/bash
set -e

tailscale set \
  --advertise-routes=${advertised_route} \
  --accept-routes=true \
  --snat-subnet-routes=false
EOF

chmod 700 /usr/local/sbin/ticketrail-tailscale-configure
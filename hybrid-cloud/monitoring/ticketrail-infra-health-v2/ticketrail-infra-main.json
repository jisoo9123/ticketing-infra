  "title": "TicketRail 인프라 가동 상태",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "tags": [
    "ticketrail",
    "infra",
    "status-only"
  ],
  "description": "가동 상태 전용. 성능·SLO·Lag 제외. 확인 불가는 DOWN이나 정상으로 판정하지 않습니다. VM 전원은 미측정.",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend · Ready",
      "description": "On-Premise Deployment의 Ready/목표를 비교합니다.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(((max(kube_deployment_status_replicas_ready{namespace=\"app\",deployment=\"backend\"}) == bool max(kube_deployment_spec_replicas{namespace=\"app\",deployment=\"backend\"})) * (max(kube_deployment_spec_replicas{namespace=\"app\",deployment=\"backend\"}) > bool 0)) and on() (max(up{job=\"kube-state-metrics\"}) == 1)) or vector(-1)",
          "legendFormat": "Backend",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "확인 불가",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT READY",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "READY",
                  "color": "green",
                  "index": 1
                },
                "-1": {
                  "text": "확인 불가",
                  "color": "gray",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 14,
          "valueSize": 46
        }
      }
    },

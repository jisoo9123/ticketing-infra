    {
      "id": 9,
      "type": "stat",
      "title": "PostgreSQL · 구성원 역할",
      "description": "pg_is_in_recovery 기반. 역할이 바뀌면 자동으로 반영됩니다.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(((max(cnpg_pg_replication_in_recovery{namespace=\"data\",job=\"data/ticketing-postgresql\",pod=\"ticketing-postgresql-1\"}) + 1) and on() ((max(cnpg_collector_up{namespace=\"data\",job=\"data/ticketing-postgresql\",pod=\"ticketing-postgresql-1\"}) * min(up{namespace=\"data\",job=\"data/ticketing-postgresql\",pod=\"ticketing-postgresql-1\"}) * (max(kube_pod_status_ready{namespace=\"data\",pod=\"ticketing-postgresql-1\",condition=\"true\"}) and on() (max(up{job=\"kube-state-metrics\"}) == 1))) == 1)) or ((max(cnpg_collector_up{namespace=\"data\",job=\"data/ticketing-postgresql\",pod=\"ticketing-postgresql-1\"}) * min(up{namespace=\"data\",job=\"data/ticketing-postgresql\",pod=\"ticketing-postgresql-1\"}) * (max(kube_pod_status_ready{namespace=\"data\",pod=\"ticketing-postgresql-1\",condition=\"true\"}) and on() (max(up{job=\"kube-state-metrics\"}) == 1))) == 0)) or vector(-1)",
          "legendFormat": "PG-1",
          "editorMode": "code",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "(((max(cnpg_pg_replication_in_recovery{namespace=\"data\",job=\"data/ticketing-postgresql\",pod=\"ticketing-postgresql-2\"}) + 1) and on() ((max(cnpg_collector_up{namespace=\"data\",job=\"data/ticketing-postgresql\",pod=\"ticketing-postgresql-2\"}) * min(up{namespace=\"data\",job=\"data/ticketing-postgresql\",pod=\"ticketing-postgresql-2\"}) * (max(kube_pod_status_ready{namespace=\"data\",pod=\"ticketing-postgresql-2\",condition=\"true\"}) and on() (max(up{job=\"kube-state-metrics\"}) == 1))) == 1)) or ((max(cnpg_collector_up{namespace=\"data\",job=\"data/ticketing-postgresql\",pod=\"ticketing-postgresql-2\"}) * min(up{namespace=\"data\",job=\"data/ticketing-postgresql\",pod=\"ticketing-postgresql-2\"}) * (max(kube_pod_status_ready{namespace=\"data\",pod=\"ticketing-postgresql-2\",condition=\"true\"}) and on() (max(up{job=\"kube-state-metrics\"}) == 1))) == 0)) or vector(-1)",
          "legendFormat": "PG-2",
          "editorMode": "code",
          "instant": true,
          "range": false
        },

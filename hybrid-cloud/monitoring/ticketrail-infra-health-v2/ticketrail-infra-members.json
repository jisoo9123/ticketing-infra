    {
      "id": 6,
      "type": "stat",
      "title": "Kafka · 업무 파티션 Leader 수",
      "description": "Kafka Leader는 파티션 단위입니다. 0개도 Broker DOWN을 의미하지 않습니다. 두 업무 토픽 기준.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(count(max by(topic,partition) (kafka_topic_partition_leader{namespace=\"data\",topic=~\"booking.created|payment.completed\"}) == 0) or (0 * count(kafka_topic_partition_leader{namespace=\"data\",topic=~\"booking.created|payment.completed\"}))) or vector(-1)",
          "legendFormat": "Broker-0",
          "editorMode": "code",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "(count(max by(topic,partition) (kafka_topic_partition_leader{namespace=\"data\",topic=~\"booking.created|payment.completed\"}) == 1) or (0 * count(kafka_topic_partition_leader{namespace=\"data\",topic=~\"booking.created|payment.completed\"}))) or vector(-1)",
          "legendFormat": "Broker-1",
          "editorMode": "code",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "(count(max by(topic,partition) (kafka_topic_partition_leader{namespace=\"data\",topic=~\"booking.created|payment.completed\"}) == 2) or (0 * count(kafka_topic_partition_leader{namespace=\"data\",topic=~\"booking.created|payment.completed\"}))) or vector(-1)",
          "legendFormat": "Broker-2",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
